{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#1c1e21", "muted": "#8d949e", "bar": "#f5f6f7", "border": "#e4e6eb", "me_bg": "#0084ff", "me_fg": "#ffffff", "them_bg": "#e4e6eb", "them_fg": "#1c1e21"},
    "dark": {"bg": "#18191a", "fg": "#e4e6eb", "muted": "#8d949e", "bar": "#242526", "border": "#3a3b3c", "me_bg": "#0084ff", "me_fg": "#ffffff", "them_bg": "#3a3b3c", "them_fg": "#e4e6eb"},
    "sepia": {"bg": "#f8f1e0", "fg": "#3c311b", "muted": "#93825c", "bar": "#efe5cb", "border": "#dccfae", "me_bg": "#6d5410", "me_fg": "#f8f1e0", "them_bg": "#e6d9b8", "them_fg": "#3c311b"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#dddddd", "bar": "#0d0d0d", "border": "#ffffff", "me_bg": "#ffff00", "me_fg": "#000000", "them_bg": "#222222", "them_fg": "#ffffff"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Nimbus Sans", Helvetica, Arial, sans-serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    display: flex; flex-direction: column;
  }
  .chat-bar { display: flex; align-items: center; gap: 12px; background: {{ p.bar }}; border-bottom: 1px solid {{ p.border }}; padding: 10px 20px; }
  .chat-bar .avatar { width: 34px; height: 34px; border-radius: 50%; background: {{ p.me_bg }}; }
  .chat-bar .name { font-weight: bold; }
  .chat-bar .status { font-size: 0.72em; color: {{ p.muted }}; }
  .chat-bar .icons { margin-left: auto; color: {{ p.me_bg }}; letter-spacing: 12px; font-size: 1.1em; }
  .thread { flex: 1; padding: 16px 20px; overflow: hidden; }
  .message { margin-bottom: 10px; max-width: 560px; }
  .message .sender { font-size: 0.72em; color: {{ p.muted }}; margin: 0 10px 2px 10px; }
  .bubble { display: inline-block; padding: 8px 14px; border-radius: 18px; background: {{ p.them_bg }}; color: {{ p.them_fg }}; }
  .message:nth-child(even) { margin-left: auto; text-align: right; }
  .message:nth-child(even) .bubble { background: {{ p.me_bg }}; color: {{ p.me_fg }}; }
  .composer { border-top: 1px solid {{ p.border }}; background: {{ p.bar }}; padding: 10px 20px; color: {{ p.muted }}; font-size: 0.85em; display: flex; gap: 12px; align-items: center; }
  .composer .input { flex: 1; background: {{ p.bg }}; border: 1px solid {{ p.border }}; border-radius: 18px; padding: 7px 16px; }
{% endblock %}

{% block content %}
<div class="chat-bar">
  <span class="avatar"></span>
  <span><div class="name">Group chat</div><div class="status">Active now</div></span>
  <span class="icons">&#9742;&#9678;</span>
</div>
<div class="thread">
{% for m in content.messages %}
<div class="message" data-target-id="{{ m.id }}" data-kind="message">
  <div class="sender">{{ macros.render_words(m.sender) }}</div>
  <div class="bubble">{{ macros.render_words(m.text) }}</div>
</div>
{% endfor %}
</div>
<div class="composer"><span class="input">Aa</span><span>&#128077;</span></div>
{% endblock %}
