{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"page": "#dfe3e8", "bg": "#ffffff", "fg": "#0b0b0f", "muted": "#8e8e93", "me_bg": "#34c759", "me_fg": "#ffffff", "them_bg": "#e9e9eb", "them_fg": "#0b0b0f", "notch": "#c9cdd2"},
    "dark": {"page": "#000000", "bg": "#121214", "fg": "#f2f2f7", "muted": "#8e8e93", "me_bg": "#0a84ff", "me_fg": "#ffffff", "them_bg": "#26262a", "them_fg": "#f2f2f7", "notch": "#2a2a2e"},
    "sepia": {"page": "#d8ccae", "bg": "#f6efdc", "fg": "#39301c", "muted": "#93825c", "me_bg": "#6d5410", "me_fg": "#f6efdc", "them_bg": "#e6dab9", "them_fg": "#39301c", "notch": "#c4b48c"},
    "high_contrast": {"page": "#000000", "bg": "#0a0a0a", "fg": "#ffffff", "muted": "#cccccc", "me_bg": "#ffff00", "me_fg": "#000000", "them_bg": "#222222", "them_fg": "#ffffff", "notch": "#333333"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "DejaVu Sans", Helvetica, sans-serif;
    background: {{ p.page }};
    color: {{ p.fg }};
  }
  .phone {
    width: 430px; height: 740px; margin: 14px auto; box-sizing: border-box;
    background: {{ p.bg }}; border-radius: 28px; overflow: hidden;
    box-shadow: 0 6px 24px rgba(0,0,0,0.35);
    display: flex; flex-direction: column;
  }
  .statusrow { display: flex; justify-content: space-between; padding: 8px 22px 4px 22px; font-size: 0.68em; color: {{ p.muted }}; }
  .contact { text-align: center; border-bottom: 1px solid {{ p.notch }}; padding-bottom: 8px; }
  .contact .c-avatar { width: 36px; height: 36px; border-radius: 50%; background: {{ p.me_bg }}; margin: 0 auto 4px auto; }
  .contact .c-name { font-size: 0.8em; font-weight: bold; }
  .msgs { flex: 1; padding: 10px 14px; overflow: hidden; }
  .message { margin-bottom: 8px; display: flex; flex-direction: column; align-items: flex-start; }
  .message .sender { font-size: 0.62em; color: {{ p.muted }}; margin: 0 10px 2px 10px; }
  .bubble { display: inline-block; max-width: 300px; padding: 7px 12px; border-radius: 16px; background: {{ p.them_bg }}; color: {{ p.them_fg }}; font-size: 0.85em; line-height: 1.35; }
  .message:nth-child(even) { align-items: flex-end; }
  .message:nth-child(even) .bubble { background: {{ p.me_bg }}; color: {{ p.me_fg }}; }
  .inputrow { display: flex; gap: 10px; padding: 8px 14px 12px 14px; align-items: center; }
  .inputrow .field { flex: 1; border: 1px solid {{ p.notch }}; border-radius: 16px; padding: 6px 14px; color: {{ p.muted }}; font-size: 0.78em; }
  .inputrow .send { width: 28px; height: 28px; border-radius: 50%; background: {{ p.me_bg }}; }
{% endblock %}

{% block content %}
<div class="phone">
  <div class="statusrow"><span>21:47</span><span>5G &nbsp; &#9646;&#9646;&#9646;</span></div>
  <div class="contact"><div class="c-avatar"></div><div class="c-name">Family group</div></div>
  <div class="msgs">
{% for m in content.messages %}
  <div class="message" data-target-id="{{ m.id }}" data-kind="message">
    <div class="sender">{{ macros.render_words(m.sender) }}</div>
    <div class="bubble">{{ macros.render_words(m.text) }}</div>
  </div>
{% endfor %}
  </div>
  <div class="inputrow"><span class="field">Message</span><span class="send"></span></div>
</div>
{% endblock %}
