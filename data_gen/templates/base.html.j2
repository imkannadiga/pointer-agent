<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 1024px;
    height: 768px;
    overflow: hidden;
  }
  {% set theme_colors = {
    "light": {"bg": "#ffffff", "fg": "#1a1a1a"},
    "dark": {"bg": "#1e1e1e", "fg": "#e8e8e8"},
    "sepia": {"bg": "#f4ecd8", "fg": "#3b2f1e"},
    "high_contrast": {"bg": "#000000", "fg": "#ffff00"},
  } %}
  {% set colors = theme_colors.get(theme, theme_colors["light"]) %}
  body {
    position: relative;
    font-family: {{ font_family | default("Arial, Helvetica, sans-serif") }};
    font-size: {{ font_size | default(16) }}px;
    background: {{ colors.bg }};
    color: {{ colors.fg }};
    box-sizing: border-box;
  }
  .word, .char {
    display: inline;
  }
  {% block extra_style %}{% endblock %}
</style>
</head>
<body>
{% block content %}{% endblock %}
{% if occlusion_box %}
<div style="position: absolute; left: {{ occlusion_box.x }}px; top: {{ occlusion_box.y }}px; width: {{ occlusion_box.w }}px; height: {{ occlusion_box.h }}px; background: rgba(120,120,120,0.45); pointer-events: none; z-index: 999;"></div>
{% endif %}
</body>
</html>
