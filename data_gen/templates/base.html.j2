<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 1024px;
    height: 768px;
    overflow: hidden;
  }
  body {
    font-family: {{ font_family | default("Arial, Helvetica, sans-serif") }};
    font-size: {{ font_size | default(16) }}px;
    background: {{ "#1e1e1e" if theme == "dark" else "#ffffff" }};
    color: {{ "#e8e8e8" if theme == "dark" else "#1a1a1a" }};
    box-sizing: border-box;
  }
  .word {
    display: inline;
  }
  {% block extra_style %}{% endblock %}
</style>
</head>
<body>
{% block content %}{% endblock %}
</body>
</html>
