{% macro render_words(words) -%}
{% for w in words %}<span class="word" data-target-id="{{ w.id }}" data-kind="{{ w.kind }}" data-text="{{ w.text | e }}">{{ w.text }}</span>{% if not loop.last %} {% endif %}{% endfor %}
{%- endmacro %}

{% macro render_word_chars(w) -%}
<span class="word" data-target-id="{{ w.id }}" data-kind="{{ w.kind }}" data-text="{{ w.text | e }}">{% for c in w.chars %}<span class="char" data-target-id="{{ c.id }}" data-kind="{{ c.kind }}" data-text="{{ c.ch | e }}">{{ c.ch }}</span>{% endfor %}</span>
{%- endmacro %}

{% macro render_paragraph_words(words) -%}
{% for w in words %}{% if w.chars %}{{ render_word_chars(w) }}{% else %}<span class="word" data-target-id="{{ w.id }}" data-kind="{{ w.kind }}" data-text="{{ w.text | e }}">{{ w.text }}</span>{% endif %}{% if not loop.last %} {% endif %}{% endfor %}
{%- endmacro %}

{% macro render_paragraph(para) -%}
<p data-target-id="{{ para.id }}" data-kind="{{ para.kind }}">{{ render_paragraph_words(para.words) }}</p>
{%- endmacro %}

{% macro render_structural(block, tag="div") -%}
<{{ tag }} data-target-id="{{ block.id }}" data-kind="{{ block.kind }}">{{ render_words(block.words) }}</{{ tag }}>
{%- endmacro %}

{% macro render_field(field, tag="span") -%}
<{{ tag }} data-target-id="{{ field.id }}" data-kind="{{ field.kind }}" data-field="{{ field.field }}" data-text="{{ field.text | e }}">{{ field.text }}</{{ tag }}>
{%- endmacro %}

{% macro occlusion_overlay(box) -%}
{% if box %}
<div style="position: absolute; left: {{ box.x }}px; top: {{ box.y }}px; width: {{ box.w }}px; height: {{ box.h }}px; background: rgba(120,120,120,0.45); pointer-events: none; z-index: 999;"></div>
{% endif %}
{%- endmacro %}
