{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#212121", "muted": "#9e9e9e", "chrome": "#f5f5f5", "border": "#e0e0e0", "cell_border": "#cfcfcf", "in_label": "#2f6fbd", "active": "#66bb6a"},
    "dark": {"bg": "#111318", "fg": "#d4d4d4", "muted": "#6e7681", "chrome": "#1b1e24", "border": "#2d323b", "cell_border": "#3a404c", "in_label": "#6ca6e8", "active": "#4f9e55"},
    "sepia": {"bg": "#f8f0dc", "fg": "#41341e", "muted": "#9c8b64", "chrome": "#efe4c8", "border": "#dccfae", "cell_border": "#c9b98f", "in_label": "#1e5aa0", "active": "#5a7a2e"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#cccccc", "chrome": "#0a0a0a", "border": "#ffffff", "cell_border": "#ffff00", "in_label": "#00ffff", "active": "#00ff00"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Liberation Sans", Arial, sans-serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
  }
  .menubar { background: {{ p.chrome }}; border-bottom: 1px solid {{ p.border }}; padding: 7px 16px; font-size: 0.75em; display: flex; gap: 18px; }
  .toolbar { background: {{ p.chrome }}; border-bottom: 1px solid {{ p.border }}; padding: 5px 16px; font-size: 0.7em; color: {{ p.muted }}; display: flex; gap: 10px; }
  .toolbar .tbtn { border: 1px solid {{ p.border }}; border-radius: 3px; padding: 2px 9px; }
  .cells { padding: 14px 30px; }
  .cell { display: flex; margin-bottom: 12px; }
  .cell.active-cell { border-left: 4px solid {{ p.active }}; padding-left: 6px; margin-left: -10px; }
  .in-label { width: 74px; flex-shrink: 0; color: {{ p.in_label }}; font-family: "DejaVu Sans Mono", monospace; font-size: 0.8em; padding-top: 8px; text-align: right; padding-right: 10px; box-sizing: border-box; }
  .cell-box { flex: 1; border: 1px solid {{ p.cell_border }}; border-radius: 3px; background: {{ p.chrome }}; padding: 7px 12px; }
  .line { display: flex; white-space: pre; line-height: 1.5; font-family: "DejaVu Sans Mono", monospace; font-size: 0.9em; }
  .indent { display: inline-block; }
{% endblock %}

{% block content %}
<div class="menubar"><span>File</span><span>Edit</span><span>View</span><span>Insert</span><span>Cell</span><span>Kernel</span><span>Help</span></div>
<div class="toolbar"><span class="tbtn">+ Code</span><span class="tbtn">Run</span><span class="tbtn">&#9632; Stop</span><span class="tbtn">Restart</span><span style="margin-left:auto;">Python 3 (ipykernel) &#9679;</span></div>
<div class="cells">
{% for chunk in content.lines | batch(5) %}
<div class="cell{{ " active-cell" if loop.index == 2 else "" }}">
  <div class="in-label">In&nbsp;[{{ loop.index }}]:</div>
  <div class="cell-box">
  {% for line in chunk %}
  <div class="line"><span class="indent" style="padding-left: {{ line.indent * 22 }}px;">{{ macros.render_words(line.tokens) }}</span></div>
  {% endfor %}
  </div>
</div>
{% endfor %}
</div>
{% endblock %}
