{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#1f2328", "muted": "#8c959f", "chrome": "#f6f8fa", "border": "#d1d9e0", "add_bg": "#dafbe1", "del_bg": "#ffebe9", "add_fg": "#1a7f37", "del_fg": "#cf222e"},
    "dark": {"bg": "#0d1117", "fg": "#e6edf3", "muted": "#7d8590", "chrome": "#161b22", "border": "#30363d", "add_bg": "#12261e", "del_bg": "#25171c", "add_fg": "#3fb950", "del_fg": "#f85149"},
    "sepia": {"bg": "#f8f1df", "fg": "#3e321c", "muted": "#9c8b64", "chrome": "#efe5cb", "border": "#d8c9a3", "add_bg": "#e2ecc8", "del_bg": "#f4d9c8", "add_fg": "#3d6b1e", "del_fg": "#a03518"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#cccccc", "chrome": "#0d0d0d", "border": "#ffffff", "add_bg": "#003300", "del_bg": "#330000", "add_fg": "#00ff00", "del_fg": "#ff5555"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Liberation Mono", "Courier New", monospace;
    background: {{ p.bg }};
    color: {{ p.fg }};
  }
  .file-header {
    display: flex; align-items: center; gap: 14px;
    background: {{ p.chrome }}; border-bottom: 1px solid {{ p.border }};
    padding: 10px 18px; font-family: "Liberation Sans", Arial, sans-serif; font-size: 0.78em;
  }
  .file-header .path { font-family: "Liberation Mono", monospace; font-weight: bold; }
  .file-header .adds { color: {{ p.add_fg }}; }
  .file-header .dels { color: {{ p.del_fg }}; }
  .file-header .viewed { margin-left: auto; color: {{ p.muted }}; border: 1px solid {{ p.border }}; border-radius: 5px; padding: 3px 10px; }
  .hunk { background: {{ p.chrome }}; color: {{ p.muted }}; padding: 4px 18px; font-size: 0.85em; border-bottom: 1px solid {{ p.border }}; }
  .line { display: flex; white-space: pre; line-height: 1.55; }
  .line.add { background: {{ p.add_bg }}; }
  .line.del { background: {{ p.del_bg }}; }
  .gutter { width: 42px; color: {{ p.muted }}; user-select: none; text-align: right; padding-right: 8px; flex-shrink: 0; box-sizing: border-box; border-right: 1px solid {{ p.border }}; }
  .marker { width: 22px; text-align: center; flex-shrink: 0; user-select: none; }
  .line.add .marker { color: {{ p.add_fg }}; }
  .line.del .marker { color: {{ p.del_fg }}; }
  .indent { display: inline-block; }
{% endblock %}

{% block content %}
<div class="file-header">
  <span class="path">src/pipeline/worker.py</span>
  <span class="adds">+18</span><span class="dels">&minus;7</span>
  <span class="viewed">&#10003; Viewed</span>
</div>
<div class="hunk">@@ -41,12 +41,18 @@ class Worker:</div>
{% for line in content.lines %}
{% set kind = "add" if loop.index % 7 == 3 else ("del" if loop.index % 7 == 5 else "ctx") %}
<div class="line {{ kind }}"><span class="gutter">{{ loop.index + 41 }}</span><span class="gutter">{{ loop.index + 44 }}</span><span class="marker">{{ "+" if kind == "add" else ("-" if kind == "del" else " ") }}</span><span class="indent" style="padding-left: {{ line.indent * 24 }}px;">{{ macros.render_words(line.tokens) }}</span></div>
{% endfor %}
{% endblock %}
