{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#24292f", "muted": "#656d76", "side_bg": "#f6f8fa", "border": "#d8dee4", "accent": "#0969da", "danger": "#cf222e"},
    "dark": {"bg": "#0e1116", "fg": "#e6edf3", "muted": "#7d8590", "side_bg": "#151b23", "border": "#2d333b", "accent": "#58a6ff", "danger": "#f85149"},
    "sepia": {"bg": "#f9f2e1", "fg": "#3a2f19", "muted": "#8d7d58", "side_bg": "#f0e6cb", "border": "#d9c99e", "accent": "#8a5a12", "danger": "#a03518"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#cccccc", "side_bg": "#0d0d0d", "border": "#ffffff", "accent": "#ffff00", "danger": "#ff5555"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "DejaVu Sans", Verdana, sans-serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    display: flex;
  }
  .settings-nav { width: 210px; flex-shrink: 0; height: 768px; background: {{ p.side_bg }}; border-right: 1px solid {{ p.border }}; padding: 20px 0; box-sizing: border-box; font-size: 0.82em; }
  .settings-nav .nav-title { font-weight: bold; padding: 0 20px 14px 20px; font-size: 1.05em; }
  .settings-nav .item { padding: 7px 20px; color: {{ p.muted }}; }
  .settings-nav .item.on { color: {{ p.fg }}; font-weight: bold; border-left: 3px solid {{ p.accent }}; padding-left: 17px; background: rgba(128,128,128,0.08); }
  .settings-nav .item.danger { color: {{ p.danger }}; margin-top: 16px; }
  .panel { flex: 1; padding: 26px 44px; box-sizing: border-box; }
  h1 { font-size: 1.25em; margin: 0 0 4px 0; }
  .panel-sub { color: {{ p.muted }}; font-size: 0.78em; margin-bottom: 18px; }
  .field-row { display: flex; align-items: baseline; padding: 13px 4px; border-bottom: 1px solid {{ p.border }}; }
  .field-label { width: 250px; flex-shrink: 0; font-size: 0.88em; color: {{ p.muted }}; }
  .field-value { font-size: 0.92em; }
  .edit { margin-left: auto; color: {{ p.accent }}; font-size: 0.78em; }
  .save-row { margin-top: 22px; }
  .save-btn { display: inline-block; background: {{ p.accent }}; color: {{ p.bg }}; border-radius: 6px; padding: 8px 20px; font-size: 0.82em; font-weight: bold; }
{% endblock %}

{% block content %}
<div class="settings-nav">
  <div class="nav-title">Settings</div>
  <div class="item">General</div>
  <div class="item on">Account</div>
  <div class="item">Notifications</div>
  <div class="item">Security</div>
  <div class="item">Billing</div>
  <div class="item">Integrations</div>
  <div class="item danger">Delete account</div>
</div>
<div class="panel">
  <h1>{{ macros.render_structural(content.title, tag="span") }}</h1>
  <div class="panel-sub">Changes are saved to your profile immediately.</div>
{% for field in content.fields %}
  <div class="field-row" data-target-id="{{ field.id }}" data-kind="field-row">
    <div class="field-label">{{ macros.render_words(field.label) }}</div>
    <div class="field-value">{{ macros.render_words(field.value) }}</div>
    <span class="edit">Edit</span>
  </div>
{% endfor %}
  <div class="save-row"><span class="save-btn">Save changes</span></div>
</div>
{% endblock %}
