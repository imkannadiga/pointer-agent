{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#f7f8fa", "fg": "#23272f", "muted": "#7d838f", "band": "#134e4a", "band_fg": "#ffffff", "card": "#ffffff", "border": "#e3e6ea", "accent": "#0d9488"},
    "dark": {"bg": "#101216", "fg": "#e5e7eb", "muted": "#858b97", "band": "#042f2e", "band_fg": "#ccfbf1", "card": "#181b21", "border": "#2a2e36", "accent": "#2dd4bf"},
    "sepia": {"bg": "#eee3c6", "fg": "#3a2f19", "muted": "#93825c", "band": "#4a3a18", "band_fg": "#f6ecd2", "card": "#f9f2e1", "border": "#dccfa8", "accent": "#8a5a12"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#cccccc", "band": "#1a1a00", "band_fg": "#ffff00", "card": "#0a0a0a", "border": "#ffffff", "accent": "#ffff00"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "FreeSans", "DejaVu Sans", sans-serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
  }
  .band { background: {{ p.band }}; color: {{ p.band_fg }}; padding: 24px 60px 54px 60px; display: flex; align-items: center; gap: 18px; }
  .p-avatar { width: 58px; height: 58px; border-radius: 50%; background: {{ p.band_fg }}; opacity: 0.9; }
  h1 { font-size: 1.35em; margin: 0; }
  .band .role { font-size: 0.76em; opacity: 0.8; margin-top: 3px; }
  .band .edit-btn { margin-left: auto; border: 1px solid {{ p.band_fg }}; border-radius: 6px; padding: 6px 16px; font-size: 0.76em; }
  .card {
    background: {{ p.card }}; border: 1px solid {{ p.border }}; border-radius: 10px;
    margin: -28px 60px 0 60px; padding: 20px 30px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
  }
  .card-title { font-size: 0.72em; text-transform: uppercase; letter-spacing: 2px; color: {{ p.accent }}; font-weight: bold; margin-bottom: 12px; }
  .grid { display: flex; flex-wrap: wrap; }
  .field-row { width: 50%; box-sizing: border-box; padding: 9px 18px 9px 0; }
  .field-label { font-size: 0.72em; color: {{ p.muted }}; margin-bottom: 2px; }
  .field-value { font-size: 0.92em; border-bottom: 1px solid {{ p.border }}; padding-bottom: 6px; }
  .activity { margin: 16px 60px; font-size: 0.72em; color: {{ p.muted }}; }
{% endblock %}

{% block content %}
<div class="band">
  <span class="p-avatar"></span>
  <span><h1>{{ macros.render_structural(content.title, tag="span") }}</h1><div class="role">Member since 2021 &middot; Verified</div></span>
  <span class="edit-btn">Edit profile</span>
</div>
<div class="card">
  <div class="card-title">Contact details</div>
  <div class="grid">
{% for field in content.fields %}
  <div class="field-row" data-target-id="{{ field.id }}" data-kind="field-row">
    <div class="field-label">{{ macros.render_words(field.label) }}</div>
    <div class="field-value">{{ macros.render_words(field.value) }}</div>
  </div>
{% endfor %}
  </div>
</div>
<div class="activity">Last updated 3 days ago &middot; Visible to workspace members only</div>
{% endblock %}
