{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"page": "#eef1f8", "bg": "#ffffff", "fg": "#1f2430", "muted": "#7a8194", "border": "#d9dee9", "accent": "#7c3aed", "accent_fg": "#ffffff", "step_off": "#d9dee9"},
    "dark": {"page": "#0d0f16", "bg": "#181c26", "fg": "#e8eaf2", "muted": "#8a90a2", "border": "#2c3242", "accent": "#a78bfa", "accent_fg": "#181c26", "step_off": "#2c3242"},
    "sepia": {"page": "#e8dcbd", "bg": "#f9f2e1", "fg": "#3a2f19", "muted": "#93825c", "border": "#d9c99e", "accent": "#6d5410", "accent_fg": "#f9f2e1", "step_off": "#d9c99e"},
    "high_contrast": {"page": "#000000", "bg": "#0a0a0a", "fg": "#ffffff", "muted": "#cccccc", "border": "#ffffff", "accent": "#ffff00", "accent_fg": "#000000", "step_off": "#333333"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Nimbus Sans", Helvetica, Arial, sans-serif;
    background: {{ p.page }};
    color: {{ p.fg }};
  }
  .wizard {
    width: 520px; margin: 22px auto; box-sizing: border-box;
    background: {{ p.bg }}; border-radius: 14px; padding: 26px 40px;
    box-shadow: 0 10px 34px rgba(0,0,0,0.14);
  }
  .steps { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 18px; }
  .step { width: 26px; height: 26px; border-radius: 50%; background: {{ p.step_off }}; color: {{ p.muted }}; text-align: center; line-height: 26px; font-size: 0.7em; font-weight: bold; }
  .step.done { background: {{ p.accent }}; color: {{ p.accent_fg }}; }
  .step-line { width: 40px; height: 2px; background: {{ p.step_off }}; }
  h1 { font-size: 1.25em; text-align: center; margin: 0 0 4px 0; }
  .wiz-sub { text-align: center; color: {{ p.muted }}; font-size: 0.76em; margin-bottom: 20px; }
  .field-row { margin-bottom: 12px; }
  .field-label { font-size: 0.72em; text-transform: uppercase; letter-spacing: 1px; color: {{ p.muted }}; margin-bottom: 3px; }
  .field-value { border: 1px solid {{ p.border }}; border-radius: 8px; padding: 8px 12px; font-size: 0.9em; }
  .wiz-actions { display: flex; justify-content: space-between; margin-top: 20px; align-items: center; }
  .back { color: {{ p.muted }}; font-size: 0.8em; }
  .next { background: {{ p.accent }}; color: {{ p.accent_fg }}; border-radius: 8px; padding: 9px 26px; font-size: 0.85em; font-weight: bold; }
{% endblock %}

{% block content %}
<div class="wizard">
  <div class="steps">
    <span class="step done">1</span><span class="step-line"></span>
    <span class="step done">2</span><span class="step-line"></span>
    <span class="step">3</span><span class="step-line"></span>
    <span class="step">4</span>
  </div>
  <h1>{{ macros.render_structural(content.title, tag="span") }}</h1>
  <div class="wiz-sub">Step 2 of 4 &mdash; tell us about yourself</div>
{% for field in content.fields %}
  <div class="field-row" data-target-id="{{ field.id }}" data-kind="field-row">
    <div class="field-label">{{ macros.render_words(field.label) }}</div>
    <div class="field-value">{{ macros.render_words(field.value) }}</div>
  </div>
{% endfor %}
  <div class="wiz-actions"><span class="back">&larr; Back</span><span class="next">Continue</span></div>
</div>
{% endblock %}
