{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#1b1b1b", "muted": "#6a6a6a", "rule": "#9a9a9a"},
    "dark": {"bg": "#20242a", "fg": "#dfe3e8", "muted": "#98a0aa", "rule": "#5a636e"},
    "sepia": {"bg": "#f8f1de", "fg": "#39301c", "muted": "#8d7f60", "rule": "#b3a175"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#dddddd", "rule": "#ffff00"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "C059", "Nimbus Roman", "Liberation Serif", serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    padding: 30px 58px;
  }
  .journal-head { display: flex; justify-content: space-between; font-size: 0.68em; color: {{ p.muted }}; font-style: italic; border-bottom: 1px solid {{ p.rule }}; padding-bottom: 5px; margin-bottom: 22px; }
  h1 { font-size: 1.4em; text-align: center; font-weight: bold; margin: 0 70px 10px 70px; line-height: 1.3; }
  .authors { text-align: center; font-size: 0.85em; margin-bottom: 4px; }
  .affil { text-align: center; font-size: 0.72em; color: {{ p.muted }}; font-style: italic; margin-bottom: 18px; }
  .abstract-rule { border-top: 1px solid {{ p.rule }}; width: 300px; margin: 0 auto 20px auto; }
  .columns { display: flex; gap: 26px; }
  .column { flex: 1; }
  .column p { margin: 0 0 12px 0; text-align: justify; line-height: 1.45; font-size: 0.88em; }
  .journal-foot { position: absolute; bottom: 12px; left: 58px; right: 58px; display: flex; justify-content: space-between; font-size: 0.66em; color: {{ p.muted }}; border-top: 1px solid {{ p.rule }}; padding-top: 5px; }
{% endblock %}

{% block content %}
<div class="journal-head"><span>Journal of Applied Studies, Vol. 31 (2)</span><span>doi:10.5555/jas.2024.0217</span></div>
<h1>{{ macros.render_structural(content.headline, tag="span") }}</h1>
<div class="authors">M. Okonkwo &middot; L. Ferrand &middot; T. Hasegawa</div>
<div class="affil">Department of Systems Research, Institute of Applied Studies</div>
<div class="abstract-rule"></div>
<div class="columns">
{% for col in content.columns %}
  <div class="column">
  {% for para in col.paragraphs %}
  {{ macros.render_paragraph(para) }}
  {% endfor %}
  </div>
{% endfor %}
</div>
<div class="journal-foot"><span>&copy; 2024 Institute of Applied Studies</span><span>217</span></div>
{% endblock %}
