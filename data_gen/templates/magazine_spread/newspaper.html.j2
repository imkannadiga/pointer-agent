{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#faf7ef", "fg": "#191919", "muted": "#6e6a60", "rule": "#191919"},
    "dark": {"bg": "#211f1c", "fg": "#e8e4da", "muted": "#9c968a", "rule": "#e8e4da"},
    "sepia": {"bg": "#f3e8cd", "fg": "#38290f", "muted": "#8a7852", "rule": "#38290f"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#dddddd", "rule": "#ffff00"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Liberation Serif", "Times New Roman", serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    padding: 22px 46px;
  }
  .masthead { text-align: center; border-bottom: 1px solid {{ p.rule }}; padding-bottom: 6px; margin-bottom: 4px; }
  .masthead .paper-name { font-size: 1.3em; font-weight: bold; letter-spacing: 6px; text-transform: uppercase; }
  .dateline { display: flex; justify-content: space-between; font-size: 0.68em; color: {{ p.muted }}; border-bottom: 3px double {{ p.rule }}; padding: 4px 2px 6px 2px; margin-bottom: 16px; }
  h1 { font-size: 1.9em; text-align: center; text-transform: uppercase; line-height: 1.15; margin: 0 40px 16px 40px; font-weight: bold; }
  .columns { display: flex; gap: 0; }
  .column { flex: 1; padding: 0 18px; }
  .column + .column { border-left: 1px solid {{ p.muted }}; }
  .column p { margin: 0 0 12px 0; text-align: justify; line-height: 1.45; font-size: 0.92em; }
{% endblock %}

{% block content %}
<div class="masthead"><span class="paper-name">The Morning Gazette</span></div>
<div class="dateline"><span>Vol. CXIV &mdash; No. 88</span><span>Late City Edition</span><span>Price 3.50</span></div>
<h1>{{ macros.render_structural(content.headline, tag="span") }}</h1>
<div class="columns">
{% for col in content.columns %}
  <div class="column">
  {% for para in col.paragraphs %}
  {{ macros.render_paragraph(para) }}
  {% endfor %}
  </div>
{% endfor %}
</div>
{% endblock %}
