{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#e8ecef", "fg": "#2c3236", "muted": "#7f8a92", "card": "#ffffff", "accent": "#00796b", "border": "#d3dade"},
    "dark": {"bg": "#101619", "fg": "#dce4e8", "muted": "#7f8a92", "card": "#1a2226", "accent": "#4db6ac", "border": "#2c363c"},
    "sepia": {"bg": "#e9dfc4", "fg": "#3c311a", "muted": "#93825c", "card": "#f9f2df", "accent": "#6d5410", "border": "#d6c69e"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#dddddd", "card": "#0d0d0d", "accent": "#ffff00", "border": "#ffffff"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Bitstream Charter", Georgia, serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    padding: 26px 60px;
    box-sizing: border-box;
  }
  .issue-line { font-family: "Liberation Sans", sans-serif; display: flex; justify-content: space-between; font-size: 0.7em; text-transform: uppercase; letter-spacing: 2px; color: {{ p.muted }}; margin-bottom: 12px; }
  .card { background: {{ p.card }}; border: 1px solid {{ p.border }}; border-radius: 6px; padding: 26px 34px; box-shadow: 0 2px 8px rgba(0,0,0,0.10); }
  h1 { font-size: 1.55em; margin: 0 0 6px 0; line-height: 1.25; }
  .headline-bar { width: 90px; height: 6px; background: {{ p.accent }}; margin-bottom: 20px; }
  .columns { display: flex; gap: 30px; }
  .column { flex: 1; }
  .column p { margin: 0 0 14px 0; line-height: 1.55; font-size: 0.92em; }
  .unsub { text-align: center; font-family: "Liberation Sans", sans-serif; font-size: 0.66em; color: {{ p.muted }}; margin-top: 14px; }
{% endblock %}

{% block content %}
<div class="issue-line"><span>The Weekly Dispatch</span><span>Edition #217</span></div>
<div class="card">
  <h1>{{ macros.render_structural(content.headline, tag="span") }}</h1>
  <div class="headline-bar"></div>
  <div class="columns">
  {% for col in content.columns %}
    <div class="column">
    {% for para in col.paragraphs %}
    {{ macros.render_paragraph(para) }}
    {% endfor %}
    </div>
  {% endfor %}
  </div>
</div>
<div class="unsub">You are receiving this because you subscribed &middot; Unsubscribe &middot; View in browser</div>
{% endblock %}
