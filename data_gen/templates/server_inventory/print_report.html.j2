{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#fffef9", "fg": "#181818", "muted": "#6f6f6f", "rule": "#181818", "stripe": "#f2f0e8"},
    "dark": {"bg": "#22252a", "fg": "#e6e3da", "muted": "#9aa0a8", "rule": "#e6e3da", "stripe": "#2b2f36"},
    "sepia": {"bg": "#f7efdb", "fg": "#3c2f1a", "muted": "#8d7c58", "rule": "#3c2f1a", "stripe": "#efe3c5"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#dddddd", "rule": "#ffff00", "stripe": "#141414"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Liberation Serif", "Times New Roman", serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    padding: 34px 64px;
  }
  .doc-no { text-align: right; font-size: 0.7em; color: {{ p.muted }}; margin-bottom: 6px; }
  h1 { font-size: 1.45em; text-align: center; margin: 0 0 4px 0; }
  .subtitle { text-align: center; font-size: 0.78em; color: {{ p.muted }}; font-style: italic; margin-bottom: 22px; }
  table { border-collapse: collapse; width: 100%; font-size: 0.86em; }
  thead th {
    text-align: left; text-transform: uppercase; letter-spacing: 2px; font-size: 0.78em;
    border-top: 3px solid {{ p.rule }}; border-bottom: 1px solid {{ p.rule }};
    padding: 8px 10px;
  }
  td { padding: 7px 10px; }
  tbody tr:nth-child(odd) { background: {{ p.stripe }}; }
  tbody tr:last-child td { border-bottom: 3px solid {{ p.rule }}; }
  .footnote { margin-top: 14px; font-size: 0.68em; color: {{ p.muted }}; display: flex; justify-content: space-between; }
{% endblock %}

{% block content %}
<div class="doc-no">Doc. IT-INV/07 &mdash; Rev. C</div>
<h1>{{ macros.render_structural(content.title, tag="span") }}</h1>
<div class="subtitle">Quarterly infrastructure census &mdash; distribution: restricted</div>
<table>
<thead>
<tr>
{% for h in content.headers %}<th>{{ macros.render_words(h) }}</th>{% endfor %}
</tr>
</thead>
<tbody>
{% for row in content.rows %}
<tr>
{% for cell in row %}<td>{{ macros.render_words(cell) }}</td>{% endfor %}
</tr>
{% endfor %}
</tbody>
</table>
<div class="footnote"><span>Compiled by Facilities &amp; IT Operations</span><span>Sheet 1 / 1</span></div>
{% endblock %}
