{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#f7f7f7", "fg": "#222222", "muted": "#8a8a8a", "prompt": "#0a7d33", "hdr": "#5a5a5a"},
    "dark": {"bg": "#101418", "fg": "#c8d2dc", "muted": "#546270", "prompt": "#5af78e", "hdr": "#8aa2ba"},
    "sepia": {"bg": "#2e2416", "fg": "#e8c98a", "muted": "#7d6742", "prompt": "#ffd28f", "hdr": "#c9a86a"},
    "high_contrast": {"bg": "#000000", "fg": "#00ff00", "muted": "#008800", "prompt": "#ffff00", "hdr": "#ffffff"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "DejaVu Sans Mono", monospace;
    background: {{ p.bg }};
    color: {{ p.fg }};
    padding: 18px 24px;
    font-size: {{ font_size - 2 }}px;
  }
  .cmd { margin-bottom: 12px; }
  .cmd .ps1 { color: {{ p.prompt }}; }
  .cmd .flag { color: {{ p.muted }}; }
  h1 { font-size: 1em; font-weight: normal; color: {{ p.muted }}; margin: 0 0 10px 0; }
  h1:before { content: "# "; }
  table { border-collapse: collapse; }
  th { text-align: left; color: {{ p.hdr }}; font-weight: bold; padding: 2px 26px 2px 0; border-bottom: 1px dashed {{ p.muted }}; }
  td { padding: 3px 26px 3px 0; vertical-align: top; }
  .summary { margin-top: 12px; color: {{ p.muted }}; }
{% endblock %}

{% block content %}
<div class="cmd"><span class="ps1">ops@bastion:~$</span> inventory list <span class="flag">--all --format table</span></div>
<h1>{{ macros.render_structural(content.title, tag="span") }}</h1>
<table>
<thead>
<tr>
{% for h in content.headers %}<th>{{ macros.render_words(h) }}</th>{% endfor %}
</tr>
</thead>
<tbody>
{% for row in content.rows %}
<tr>
{% for cell in row %}<td>{{ macros.render_words(cell) }}</td>{% endfor %}
</tr>
{% endfor %}
</tbody>
</table>
<div class="summary">{{ content.rows | length }} hosts returned in 0.4s &mdash; use --watch to follow changes</div>
{% endblock %}
