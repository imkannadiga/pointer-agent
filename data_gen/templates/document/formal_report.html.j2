{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#fdfdfb", "fg": "#1c1c1c", "muted": "#6b6b6b", "accent": "#1f3a5f", "rule": "#1c1c1c"},
    "dark": {"bg": "#23262b", "fg": "#e4e2dc", "muted": "#9aa0a8", "accent": "#8fb4e3", "rule": "#e4e2dc"},
    "sepia": {"bg": "#f6eeda", "fg": "#3d2f1c", "muted": "#8a7a5e", "accent": "#7a4d1e", "rule": "#3d2f1c"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#dddddd", "accent": "#ffff00", "rule": "#ffffff"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Liberation Serif", "Times New Roman", serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    padding: 26px 70px 40px 70px;
  }
  .report-meta {
    display: flex; justify-content: space-between;
    font-size: 0.68em; letter-spacing: 2px; text-transform: uppercase;
    color: {{ p.muted }};
    border-bottom: 1px solid {{ p.muted }};
    padding-bottom: 8px; margin-bottom: 26px;
  }
  h1 {
    font-size: 1.55em; font-weight: bold; text-align: center;
    margin: 0 0 8px 0; color: {{ p.accent }};
  }
  .title-rule {
    border-bottom: 3px double {{ p.rule }};
    width: 240px; margin: 0 auto 28px auto;
  }
  .content p {
    margin: 0 0 16px 0; text-align: justify; text-indent: 2em;
    line-height: 1.55; max-width: 880px;
  }
  .page-footer {
    position: absolute; bottom: 12px; left: 0; right: 0;
    text-align: center; font-size: 0.7em; color: {{ p.muted }};
  }
{% endblock %}

{% block content %}
<div class="report-meta"><span>Internal Report</span><span>Ref. QR-2214 &mdash; Confidential</span></div>
<h1>{{ macros.render_structural(content.title, tag="span") }}</h1>
<div class="title-rule"></div>
<div class="content">
{% for para in content.paragraphs %}
{{ macros.render_paragraph(para) }}
{% endfor %}
</div>
<div class="page-footer">Page 1 of 3</div>
{% endblock %}
