{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#24292f", "muted": "#656d76", "accent": "#0969da", "side_bg": "#f6f8fa", "border": "#d0d7de"},
    "dark": {"bg": "#0d1117", "fg": "#c9d1d9", "muted": "#8b949e", "accent": "#58a6ff", "side_bg": "#161b22", "border": "#30363d"},
    "sepia": {"bg": "#f9f2e2", "fg": "#3c3222", "muted": "#8d7f63", "accent": "#8a5a12", "side_bg": "#f0e6cf", "border": "#dccfae"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#ffff00", "accent": "#00ffff", "side_bg": "#0a0a0a", "border": "#ffffff"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "FreeSans", "DejaVu Sans", sans-serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    display: flex;
  }
  .sidebar {
    width: 200px; flex-shrink: 0; height: 768px;
    background: {{ p.side_bg }}; border-right: 1px solid {{ p.border }};
    padding: 18px 0; font-size: 0.8em; box-sizing: border-box;
  }
  .sidebar .group { color: {{ p.muted }}; text-transform: uppercase; font-size: 0.85em; letter-spacing: 1px; padding: 10px 18px 4px 18px; }
  .sidebar .item { padding: 5px 18px; color: {{ p.muted }}; }
  .sidebar .item.active { color: {{ p.accent }}; border-left: 3px solid {{ p.accent }}; padding-left: 15px; font-weight: bold; }
  .main { padding: 22px 40px; box-sizing: border-box; }
  .breadcrumb { font-size: 0.75em; color: {{ p.muted }}; margin-bottom: 14px; }
  .breadcrumb .sep { margin: 0 6px; }
  h1 { font-size: 1.5em; margin: 0 0 8px 0; padding-bottom: 10px; border-bottom: 1px solid {{ p.border }}; }
  .main p { margin: 14px 0 0 0; line-height: 1.65; max-width: 640px; }
{% endblock %}

{% block content %}
<div class="sidebar">
  <div class="group">Getting started</div>
  <div class="item">Overview</div>
  <div class="item active">Guide</div>
  <div class="item">Installation</div>
  <div class="group">Reference</div>
  <div class="item">Configuration</div>
  <div class="item">CLI commands</div>
  <div class="item">Changelog</div>
</div>
<div class="main">
  <div class="breadcrumb">Docs<span class="sep">/</span>Guides<span class="sep">/</span>Current page</div>
  <h1>{{ macros.render_structural(content.title, tag="span") }}</h1>
{% for para in content.paragraphs %}
{{ macros.render_paragraph(para) }}
{% endfor %}
</div>
{% endblock %}
