{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#2b2b2b", "muted": "#8a8a8a", "band": "#0f5c46", "band_fg": "#ffffff"},
    "dark": {"bg": "#1d2320", "fg": "#e3e8e4", "muted": "#93a49a", "band": "#0a3d2e", "band_fg": "#d7f2e6"},
    "sepia": {"bg": "#f7f0dd", "fg": "#40331f", "muted": "#93855f", "band": "#5f4a1e", "band_fg": "#f7f0dd"},
    "high_contrast": {"bg": "#000000", "fg": "#ffff00", "muted": "#ffffff", "band": "#ffff00", "band_fg": "#000000"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Nimbus Sans", Helvetica, Arial, sans-serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
  }
  .band {
    background: {{ p.band }}; color: {{ p.band_fg }};
    padding: 14px 56px; display: flex; align-items: center; gap: 12px;
  }
  .logo-dot {
    width: 18px; height: 18px; border-radius: 50%;
    background: {{ p.band_fg }}; display: inline-block;
  }
  .band .company { font-size: 1.05em; font-weight: bold; letter-spacing: 3px; text-transform: uppercase; }
  .letter { padding: 26px 56px 40px 56px; }
  .ref-line { text-align: right; color: {{ p.muted }}; font-size: 0.78em; margin-bottom: 22px; }
  .subject { font-weight: bold; margin-bottom: 20px; font-size: 1.05em; }
  .subject .label { color: {{ p.muted }}; font-weight: normal; margin-right: 8px; }
  .letter p { margin: 0 0 15px 0; line-height: 1.65; max-width: 860px; }
  .letter-footer {
    position: absolute; bottom: 10px; left: 56px; right: 56px;
    border-top: 1px solid {{ p.muted }}; padding-top: 6px;
    font-size: 0.66em; color: {{ p.muted }}; display: flex; justify-content: space-between;
  }
{% endblock %}

{% block content %}
<div class="band"><span class="logo-dot"></span><span class="company">Meridian &amp; Partners</span></div>
<div class="letter">
  <div class="ref-line">Our ref. MP/4471 &mdash; direct line 402</div>
  <div class="subject"><span class="label">Subject:</span>{{ macros.render_structural(content.title, tag="span") }}</div>
{% for para in content.paragraphs %}
{{ macros.render_paragraph(para) }}
{% endfor %}
</div>
<div class="letter-footer"><span>Meridian &amp; Partners &middot; Registered office</span><span>meridian-partners.example</span></div>
{% endblock %}
