{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  body { padding: 20px; }
  .message { margin-bottom: 14px; max-width: 640px; }
  .sender { font-weight: bold; font-size: 0.85em; margin-bottom: 2px; }
  .bubble {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 10px;
    background: {{ "#2f2f2f" if theme == "dark" else "#eef1f5" }};
  }
{% endblock %}

{% block content %}
{% for m in content.messages %}
<div class="message" data-target-id="{{ m.id }}" data-kind="message">
  <div class="sender">{{ macros.render_words(m.sender) }}</div>
  <div class="bubble">{{ macros.render_words(m.text) }}</div>
</div>
{% endfor %}
{% endblock %}
