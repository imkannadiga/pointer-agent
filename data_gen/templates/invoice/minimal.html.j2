{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#2a2a2a", "muted": "#9b9b9b", "rule": "#2a2a2a", "hair": "#e5e5e5"},
    "dark": {"bg": "#191b1e", "fg": "#e2e4e6", "muted": "#7e848a", "rule": "#e2e4e6", "hair": "#33373c"},
    "sepia": {"bg": "#f9f2e2", "fg": "#3a2f19", "muted": "#9c8b64", "rule": "#3a2f19", "hair": "#e2d5b2"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#cccccc", "rule": "#ffff00", "hair": "#444444"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Nimbus Sans", Helvetica, Arial, sans-serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
    padding: 44px 90px;
  }
  .top { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 2px solid {{ p.rule }}; padding-bottom: 14px; margin-bottom: 26px; }
  .top .t { font-size: 1.15em; letter-spacing: 8px; text-transform: uppercase; }
  .top .no { color: {{ p.muted }}; font-size: 0.85em; }
  .meta-cols { display: flex; gap: 60px; margin-bottom: 30px; font-size: 0.8em; line-height: 1.75; }
  .meta-col .k { text-transform: uppercase; letter-spacing: 2px; font-size: 0.72em; color: {{ p.muted }}; }
  .meta-col { max-width: 260px; }
  .items { margin-bottom: 26px; }
  .item-line { padding: 9px 2px; border-bottom: 1px solid {{ p.hair }}; font-size: 0.86em; }
  .totals { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; font-size: 0.86em; }
  .t-line { display: flex; gap: 40px; }
  .t-line .k { color: {{ p.muted }}; text-transform: uppercase; letter-spacing: 1px; font-size: 0.8em; }
  .t-line.grand { border-top: 2px solid {{ p.rule }}; padding-top: 8px; font-weight: bold; }
  .foot { position: absolute; bottom: 26px; left: 90px; right: 90px; font-size: 0.68em; color: {{ p.muted }}; display: flex; justify-content: space-between; }
{% endblock %}

{% block content %}
{% set f = content.fields %}
<div class="top">
  <span class="t">Invoice</span>
  <span class="no">{{ macros.render_field(f.invoice_number) }}</span>
</div>
<div class="meta-cols">
  <div class="meta-col">
    <div class="k">From</div>
    <div>{{ macros.render_field(f.invoice_sender) }}</div>
    <div>{{ macros.render_field(f.invoice_sender_city) }} {{ macros.render_field(f.invoice_sender_zip) }}</div>
    <div>{{ macros.render_field(f.invoice_email) }}</div>
    <div>{{ macros.render_field(f.invoice_phone) }}</div>
  </div>
  <div class="meta-col">
    <div class="k">Billed to</div>
    <div>{{ macros.render_field(f.invoice_recipient) }}</div>
    <div>{{ macros.render_field(f.invoice_recipient_city) }} {{ macros.render_field(f.invoice_recipient_zip) }}</div>
  </div>
  <div class="meta-col">
    <div class="k">Details</div>
    <div>Issued {{ macros.render_field(f.invoice_date) }}</div>
    <div>Due {{ macros.render_field(f.invoice_due_date) }}</div>
    <div>Tax ID {{ macros.render_field(f.invoice_tax_id) }}</div>
  </div>
</div>
<div class="items" data-target-id="{{ content.line_items_container.id }}" data-kind="{{ content.line_items_container.kind }}" data-field="{{ content.line_items_container.field }}">
{% for item in content.line_items %}
  <div class="item-line">{{ macros.render_field(item, tag="span") }}</div>
{% endfor %}
</div>
<div class="totals">
  <div class="t-line"><span class="k">Subtotal</span>{{ macros.render_field(f.invoice_subtotal) }}</div>
  <div class="t-line"><span class="k">Tax</span>{{ macros.render_field(f.invoice_tax) }}</div>
  <div class="t-line"><span class="k">Total</span>{{ macros.render_field(f.invoice_total) }}</div>
  <div class="t-line grand">{{ macros.render_field(f.invoice_totals) }}</div>
</div>
<div class="foot">
  <span>IBAN {{ macros.render_field(f.invoice_iban) }} &middot; BIC {{ macros.render_field(f.invoice_bic) }} &middot; {{ macros.render_field(f.invoice_bank_details) }}</span>
  <span>Thank you</span>
</div>
{% endblock %}
