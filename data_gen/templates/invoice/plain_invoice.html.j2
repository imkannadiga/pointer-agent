{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  body { padding: 36px; }
  .row { display: flex; justify-content: space-between; margin-bottom: 24px; }
  .block { margin-bottom: 6px; }
  .label { font-size: 0.8em; opacity: 0.7; margin-right: 6px; }
  table { border-collapse: collapse; width: 100%; margin-top: 20px; }
  th, td {
    border: 1px solid {{ "#444444" if theme == "dark" else "#cccccc" }};
    padding: 6px 10px;
    text-align: left;
    font-size: 0.9em;
  }
  .totals { margin-top: 16px; text-align: right; }
{% endblock %}

{% block content %}
{% set f = content.fields %}
<div class="row">
  <div>
    <div class="block"><span class="label">From:</span>{{ macros.render_field(f.invoice_sender) }}</div>
    <div class="block">{{ macros.render_field(f.invoice_sender_city) }}, {{ macros.render_field(f.invoice_sender_zip) }}</div>
    <div class="block"><span class="label">Email:</span>{{ macros.render_field(f.invoice_email) }}</div>
    <div class="block"><span class="label">Phone:</span>{{ macros.render_field(f.invoice_phone) }}</div>
  </div>
  <div>
    <div class="block"><span class="label">Bill to:</span>{{ macros.render_field(f.invoice_recipient) }}</div>
    <div class="block">{{ macros.render_field(f.invoice_recipient_city) }}, {{ macros.render_field(f.invoice_recipient_zip) }}</div>
  </div>
</div>
<div class="row">
  <div>
    <div class="block"><span class="label">Invoice #:</span>{{ macros.render_field(f.invoice_number) }}</div>
    <div class="block"><span class="label">Date:</span>{{ macros.render_field(f.invoice_date) }}</div>
    <div class="block"><span class="label">Due:</span>{{ macros.render_field(f.invoice_due_date) }}</div>
  </div>
  <div>
    <div class="block"><span class="label">Tax ID:</span>{{ macros.render_field(f.invoice_tax_id) }}</div>
    <div class="block"><span class="label">BIC:</span>{{ macros.render_field(f.invoice_bic) }}</div>
    <div class="block"><span class="label">IBAN:</span>{{ macros.render_field(f.invoice_iban) }}</div>
    <div class="block"><span class="label">Bank:</span>{{ macros.render_field(f.invoice_bank_details) }}</div>
  </div>
</div>
<table data-target-id="{{ content.line_items_container.id }}" data-kind="{{ content.line_items_container.kind }}" data-field="{{ content.line_items_container.field }}">
<tbody>
{% for item in content.line_items %}
<tr><td>{{ macros.render_field(item, tag="span") }}</td></tr>
{% endfor %}
</tbody>
</table>
<div class="totals">
  <div class="block"><span class="label">Subtotal:</span>{{ macros.render_field(f.invoice_subtotal) }}</div>
  <div class="block"><span class="label">Tax:</span>{{ macros.render_field(f.invoice_tax) }}</div>
  <div class="block"><span class="label">Total:</span>{{ macros.render_field(f.invoice_total) }}</div>
  <div class="block">{{ macros.render_field(f.invoice_totals) }}</div>
</div>
{% endblock %}
