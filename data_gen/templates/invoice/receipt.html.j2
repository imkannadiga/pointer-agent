{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"page": "#d8dade", "bg": "#fefefc", "fg": "#222222", "muted": "#7a7a7a", "dash": "#9a9a9a"},
    "dark": {"page": "#0d0e10", "bg": "#1d1f22", "fg": "#dddfe2", "muted": "#84888d", "dash": "#5a5e64"},
    "sepia": {"page": "#cdbf9f", "bg": "#faf3e0", "fg": "#3a2f19", "muted": "#93825c", "dash": "#af9d70"},
    "high_contrast": {"page": "#000000", "bg": "#0d0d0d", "fg": "#ffffff", "muted": "#cccccc", "dash": "#ffff00"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Liberation Mono", "Courier New", monospace;
    background: {{ p.page }};
    color: {{ p.fg }};
  }
  .receipt {
    width: 480px; margin: 16px auto; box-sizing: border-box;
    background: {{ p.bg }}; padding: 20px 28px 24px 28px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.25);
    font-size: 0.82em; line-height: 1.55;
  }
  .center { text-align: center; }
  .store { font-weight: bold; font-size: 1.15em; letter-spacing: 2px; text-transform: uppercase; }
  .sub { color: {{ p.muted }}; font-size: 0.9em; }
  .dash-rule { border-top: 1px dashed {{ p.dash }}; margin: 10px 0; }
  .kv { display: flex; justify-content: space-between; gap: 12px; }
  .kv .k { color: {{ p.muted }}; flex-shrink: 0; }
  .kv .v { text-align: right; }
  .items .item-line { padding: 2px 0; }
  .grand { font-weight: bold; font-size: 1.05em; }
  .tiny { font-size: 0.82em; color: {{ p.muted }}; }
{% endblock %}

{% block content %}
{% set f = content.fields %}
<div class="receipt">
  <div class="center">
    <div class="store">{{ macros.render_field(f.invoice_sender) }}</div>
    <div class="sub">{{ macros.render_field(f.invoice_sender_city) }} {{ macros.render_field(f.invoice_sender_zip) }}</div>
    <div class="sub">{{ macros.render_field(f.invoice_email) }}</div>
    <div class="sub">Tel: {{ macros.render_field(f.invoice_phone) }}</div>
  </div>
  <div class="dash-rule"></div>
  <div class="kv"><span class="k">Receipt no.</span><span class="v">{{ macros.render_field(f.invoice_number) }}</span></div>
  <div class="kv"><span class="k">Date</span><span class="v">{{ macros.render_field(f.invoice_date) }}</span></div>
  <div class="kv"><span class="k">Pay before</span><span class="v">{{ macros.render_field(f.invoice_due_date) }}</span></div>
  <div class="kv"><span class="k">VAT reg.</span><span class="v">{{ macros.render_field(f.invoice_tax_id) }}</span></div>
  <div class="dash-rule"></div>
  <div class="kv"><span class="k">Customer</span><span class="v">{{ macros.render_field(f.invoice_recipient) }}</span></div>
  <div class="kv"><span class="k"></span><span class="v">{{ macros.render_field(f.invoice_recipient_city) }} {{ macros.render_field(f.invoice_recipient_zip) }}</span></div>
  <div class="dash-rule"></div>
  <div class="items" data-target-id="{{ content.line_items_container.id }}" data-kind="{{ content.line_items_container.kind }}" data-field="{{ content.line_items_container.field }}">
  {% for item in content.line_items %}
    <div class="item-line">{{ macros.render_field(item, tag="span") }}</div>
  {% endfor %}
  </div>
  <div class="dash-rule"></div>
  <div class="kv"><span class="k">Subtotal</span><span class="v">{{ macros.render_field(f.invoice_subtotal) }}</span></div>
  <div class="kv"><span class="k">Tax</span><span class="v">{{ macros.render_field(f.invoice_tax) }}</span></div>
  <div class="kv grand"><span class="k">TOTAL</span><span class="v">{{ macros.render_field(f.invoice_total) }}</span></div>
  <div class="center">{{ macros.render_field(f.invoice_totals) }}</div>
  <div class="dash-rule"></div>
  <div class="tiny">
    <div>IBAN: {{ macros.render_field(f.invoice_iban) }}</div>
    <div>BIC: {{ macros.render_field(f.invoice_bic) }}</div>
    <div>{{ macros.render_field(f.invoice_bank_details) }}</div>
  </div>
  <div class="dash-rule"></div>
  <div class="center tiny">*** Thank you for your business ***</div>
</div>
{% endblock %}
