{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  {% set PAL = {
    "light": {"bg": "#ffffff", "fg": "#22262a", "muted": "#71797f", "band": "#153a5b", "band_fg": "#ffffff", "accent": "#1f6fb2", "box_bg": "#f2f6f9", "border": "#d7dee4", "stripe": "#f7fafc"},
    "dark": {"bg": "#14171a", "fg": "#dde3e8", "muted": "#87909a", "band": "#0b2438", "band_fg": "#cfe6f8", "accent": "#5aa2d8", "box_bg": "#1c2126", "border": "#333b42", "stripe": "#181d21"},
    "sepia": {"bg": "#f9f2e1", "fg": "#3a2f19", "muted": "#8d7d58", "band": "#4a3a18", "band_fg": "#f6ecd2", "accent": "#8a5a12", "box_bg": "#f1e7cd", "border": "#d9c99e", "stripe": "#f4ecd6"},
    "high_contrast": {"bg": "#000000", "fg": "#ffffff", "muted": "#cccccc", "band": "#1a1a00", "band_fg": "#ffff00", "accent": "#ffff00", "box_bg": "#0d0d0d", "border": "#ffffff", "stripe": "#111111"},
  } %}
  {% set p = PAL.get(theme, PAL["light"]) %}
  body {
    font-family: "Liberation Sans", Arial, sans-serif;
    background: {{ p.bg }};
    color: {{ p.fg }};
  }
  .band { background: {{ p.band }}; color: {{ p.band_fg }}; padding: 20px 44px; display: flex; justify-content: space-between; align-items: center; }
  .band .word-mark { font-size: 1.5em; font-weight: bold; letter-spacing: 6px; text-transform: uppercase; }
  .band .meta { text-align: right; font-size: 0.78em; line-height: 1.6; }
  .band .meta .label { opacity: 0.75; margin-right: 8px; }
  .body-wrap { padding: 18px 44px; }
  .addr-row { display: flex; gap: 20px; margin-bottom: 16px; }
  .addr-box { flex: 1; background: {{ p.box_bg }}; border: 1px solid {{ p.border }}; border-radius: 6px; padding: 10px 16px; font-size: 0.84em; line-height: 1.55; }
  .addr-box .hd { font-size: 0.78em; text-transform: uppercase; letter-spacing: 1px; color: {{ p.accent }}; font-weight: bold; margin-bottom: 4px; }
  .addr-box .sub { color: {{ p.muted }}; }
  table { border-collapse: collapse; width: 100%; font-size: 0.84em; }
  th { background: {{ p.accent }}; color: {{ p.bg }}; text-align: left; padding: 7px 12px; }
  td { padding: 7px 12px; border-bottom: 1px solid {{ p.border }}; }
  tbody tr:nth-child(even) { background: {{ p.stripe }}; }
  .bottom-row { display: flex; margin-top: 14px; gap: 20px; }
  .pay-box { flex: 1; font-size: 0.76em; color: {{ p.muted }}; line-height: 1.7; }
  .pay-box .hd { color: {{ p.fg }}; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; font-size: 0.9em; margin-bottom: 3px; }
  .totals-box { width: 300px; border: 1px solid {{ p.border }}; border-radius: 6px; font-size: 0.86em; }
  .t-row { display: flex; justify-content: space-between; padding: 6px 14px; border-bottom: 1px solid {{ p.border }}; }
  .t-row .lbl { color: {{ p.muted }}; }
  .t-row.grand { background: {{ p.band }}; color: {{ p.band_fg }}; font-weight: bold; border-bottom: none; }
{% endblock %}

{% block content %}
{% set f = content.fields %}
<div class="band">
  <span class="word-mark">Invoice</span>
  <div class="meta">
    <div><span class="label">No.</span>{{ macros.render_field(f.invoice_number) }}</div>
    <div><span class="label">Issued</span>{{ macros.render_field(f.invoice_date) }}</div>
    <div><span class="label">Due</span>{{ macros.render_field(f.invoice_due_date) }}</div>
  </div>
</div>
<div class="body-wrap">
  <div class="addr-row">
    <div class="addr-box">
      <div class="hd">From</div>
      <div>{{ macros.render_field(f.invoice_sender) }}</div>
      <div>{{ macros.render_field(f.invoice_sender_city) }}, {{ macros.render_field(f.invoice_sender_zip) }}</div>
      <div class="sub">{{ macros.render_field(f.invoice_email) }} &middot; {{ macros.render_field(f.invoice_phone) }}</div>
      <div class="sub">Tax ID: {{ macros.render_field(f.invoice_tax_id) }}</div>
    </div>
    <div class="addr-box">
      <div class="hd">Bill to</div>
      <div>{{ macros.render_field(f.invoice_recipient) }}</div>
      <div>{{ macros.render_field(f.invoice_recipient_city) }}, {{ macros.render_field(f.invoice_recipient_zip) }}</div>
    </div>
  </div>
  <table data-target-id="{{ content.line_items_container.id }}" data-kind="{{ content.line_items_container.kind }}" data-field="{{ content.line_items_container.field }}">
  <thead><tr><th>Description</th></tr></thead>
  <tbody>
  {% for item in content.line_items %}
  <tr><td>{{ macros.render_field(item, tag="span") }}</td></tr>
  {% endfor %}
  </tbody>
  </table>
  <div class="bottom-row">
    <div class="pay-box">
      <div class="hd">Payment details</div>
      <div>IBAN: {{ macros.render_field(f.invoice_iban) }}</div>
      <div>BIC: {{ macros.render_field(f.invoice_bic) }}</div>
      <div>Bank: {{ macros.render_field(f.invoice_bank_details) }}</div>
    </div>
    <div class="totals-box">
      <div class="t-row"><span class="lbl">Subtotal</span>{{ macros.render_field(f.invoice_subtotal) }}</div>
      <div class="t-row"><span class="lbl">Tax</span>{{ macros.render_field(f.invoice_tax) }}</div>
      <div class="t-row"><span class="lbl">Total</span>{{ macros.render_field(f.invoice_total) }}</div>
      <div class="t-row grand">{{ macros.render_field(f.invoice_totals) }}</div>
    </div>
  </div>
</div>
{% endblock %}
