{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block extra_style %}
  body {
    font-family: "Courier New", Courier, monospace;
    padding: 20px;
    background: {{ "#1e1e1e" if theme == "dark" else "#f5f5f5" }};
  }
  .line { display: flex; white-space: pre; line-height: 1.5; }
  .lineno {
    width: 36px;
    color: {{ "#6a6a6a" if theme == "dark" else "#999999" }};
    user-select: none;
    text-align: right;
    margin-right: 16px;
    flex-shrink: 0;
  }
  .indent { display: inline-block; }
{% endblock %}

{% block content %}
{% for line in content.lines %}
<div class="line"><span class="lineno">{{ loop.index }}</span><span class="indent" style="padding-left: {{ line.indent * 24 }}px;">{{ macros.render_words(line.tokens) }}</span></div>
{% endfor %}
{% endblock %}
